DEPLOY_HOST=your-server-ip
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
DEPLOY_KEY=/absolute/path/to/ssh-key.pem
DEPLOY_DOMAIN=your-domain.example
DEPLOY_CERTBOT_EMAIL=you@example.com
DEPLOY_APP_DIR=/opt/kaizenai

# Optional: when set, the deployment updates the server's private backend.env.
# For Gmail use an App Password, not the normal account password.
# DEPLOY_SMTP_EMAIL=you@example.com
# DEPLOY_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# DEPLOY_SMTP_HOST=smtp.gmail.com
# DEPLOY_SMTP_PORT=465
# DEPLOY_SMTP_USE_SSL=true
# DEPLOY_SMTP_FROM_NAME=KaizenAI
