PROJECT_NAME=KaizenAI
# Development default. Production must use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg2://kaizenai:password@127.0.0.1:5432/kaizenai
DATABASE_URL=sqlite:///./mvp.db
AUTO_CREATE_SCHEMA=true
SECRET_KEY=replace-with-a-long-random-value
KIE_API_KEY=
KIE_API_URL=https://api.kie.ai
BASE_URL=https://your-domain.example
CORS_ALLOW_ORIGINS=https://your-domain.example
KIE_CALLBACK_TOKEN=
SUNO_CALLBACK_TOKEN=
AI_GENERATION_ENABLED=false
BILLING_ENABLED=false
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_FROM_NAME=KaizenAI
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_QUEUE_NAME=ai_editor
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=1200
CELERY_TASK_TIME_LIMIT=1500
CELERY_RECONCILIATION_INTERVAL_SECONDS=60
UPLOAD_DIR=uploads
